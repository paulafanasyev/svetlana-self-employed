{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "web/dist",
  "installCommand": "npm install",
  "functions": {
    "api/[[...path]].js": {
      "runtime": "nodejs22.x",
      "maxDuration": 60,
      "includeFiles": [
        "backend/src/db/schema/**/*.sql"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
