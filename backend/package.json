{
  "name": "backend",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Единый backend Мир Самозанятых: auth, CRM, documents, AI/Светлана, marketplace, education, payments, RAG.",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "build": "node scripts/build-check.js",
    "migrate": "node --env-file=.env src/db/migrate.js",
    "seed": "node --env-file=.env src/db/seed.js",
    "test": "node --test --test-concurrency=1 --env-file=.env.test tests/unit/*.test.js tests/e2e/*.test.js",
    "test:unit": "node --test --env-file=.env.test tests/unit/*.test.js",
    "e2e": "node --test --env-file=.env.test tests/e2e/*.test.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.4",
    "bcryptjs": "^2.4.3",
    "docx": "^9.1.0",
    "fastify": "^5.12.5",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.5",
    "pdf-lib": "^1.17.1",
    "zod": "^3.24.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
