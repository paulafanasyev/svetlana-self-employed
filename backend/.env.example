# ============================================================================
# МИР САМОЗАНЯТЫХ — backend environment (§7: all secrets live here, never in
# the frontend or the APK). Copy to .env and fill in.
# ============================================================================

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# SQLite database file (created automatically)
DB_PATH=./data/app.sqlite
# Generated documents (DOCX files, uploads)
STORAGE_DIR=./data/storage

# --- Auth --------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_please_use_a_long_random_secret_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- CORS --------------------------------------------------------------------
WEB_ORIGIN=http://localhost:5173
# Comma-separated extra origins (production domain + GitHub Pages origin)
# CORS_ORIGINS=https://мир-самозанятых.рф,https://mir-samozanyatyh.github.io

# --- AI providers (§30) ------------------------------------------------------
# Configure at least one real provider; otherwise the deterministic `local`
# planner is used (honestly labelled, zero cost, works fully offline).
ATRIA_API_KEY=
ATRIA_BASE_URL=https://api.atria.tech/v1
ATRIA_MODEL=atria-alpha
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
LOCAL_MODEL_URL=
AI_PROVIDER_ORDER=atria,openrouter,openai,local
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

# --- Embeddings for RAG (§29) ------------------------------------------------
# 'none' = deterministic local hash-bag embeddings (no external calls)
EMBEDDING_PROVIDER=none
EMBEDDING_DIM=768

# --- Payments (§26) ----------------------------------------------------------
# 'test' is a clearly-labelled sandbox; it is REFUSED in production.
PAYMENT_PROVIDER=test
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=

# --- Marketplace commission (§25) — live value lives in system_config --------
DEFAULT_COMMISSION_PERCENT=10

# --- Rate limits -------------------------------------------------------------
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20

# --- Demo data (§54: only when explicitly true) ------------------------------
SEED_DEMO_DATA=true

# --- Optional email transport (document delivery) ----------------------------
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="Светлана <svetlana@мир-самозанятых.рф>"
